# Conventional Commit configuration for convco.
header: |
  # Changelog

  All notable changes to ArtifactSpec are documented here.
types:
  - type: feat
    section: Added
    hidden: false
  - type: fix
    section: Fixed
    hidden: false
  - type: perf
    section: Performance
    hidden: false
  - type: refactor
    section: Changed
    hidden: false
  - type: docs
    section: Documentation
    hidden: true
  - type: test
    section: Tests
    hidden: true
  - type: build
    section: Build
    hidden: true
  - type: ci
    section: CI
    hidden: true
  - type: chore
    section: Maintenance
    hidden: true
  - type: style
    section: Styling
    hidden: true
preMajor: true
releaseCommitMessageFormat: "chore(release): {{currentTag}}"
