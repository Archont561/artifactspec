{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "ArtifactSpec development",
  "image": "ghcr.io/prefix-dev/pixi:0.84.1",
  "runArgs": ["--platform=linux/amd64"],
  "containerEnv": {
    "ARTIFACTSPEC_INSTALL_OPENCODE": "${localEnv:ARTIFACTSPEC_INSTALL_OPENCODE}"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.pixi/bin:${containerEnv:HOME}/.bun/bin"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
